{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node scripts/vercel-build.mjs",
  "outputDirectory": "public",
  "framework": null,
  "cleanUrls": true,
  "rewrites": [
    { "source": "/p/:channel/:message", "destination": "/index.html" },
    { "source": "/u/:id", "destination": "/index.html" },
    { "source": "/g/:id", "destination": "/index.html" },
    { "source": "/c/:id", "destination": "/index.html" },
    { "source": "/dm/:id", "destination": "/index.html" },
    { "source": "/dm", "destination": "/index.html" },
    { "source": "/compose", "destination": "/index.html" },
    { "source": "/search", "destination": "/index.html" },
    { "source": "/activity", "destination": "/index.html" },
    { "source": "/discover", "destination": "/index.html" },
    { "source": "/settings", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600" }]
    },
    {
      "source": "/fuse-config.js",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    },
    {
      "source": "/(index.html|login.html)",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    }
  ]
}
