# Fuse 실행 설정 — 이 파일을 .env 로 복사해서 채우세요.
# 자세한 순서는 SETUP.md, 배포는 DEPLOY.md 를 보세요.

# --- 디스코드 (셋 다 비면 데모 모드로 실행됩니다) ---
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=

# --- 서버 ---
PORT=5195
BASE_URL=http://localhost:5195
SESSION_SECRET=여기를_길고_임의의_문자열로_바꾸세요

# --- 선택 ---
# 답글을 디스코드에 남기는 방식: reply(기본) | webhook | thread
# reply   = 네이티브 답장 (원본이 화살표로 딸려 보임, 작성자는 봇 이름)
# webhook = 내 이름·프사 유지 (원본은 인용문으로)
# thread  = 원본에 스레드를 만들어 그 안에
FUSE_REPLY_MODE=reply

# 화면을 다른 곳(Vercel 등)에 올렸을 때만 사용
# FUSE_APP_URL=https://fuse.vercel.app
# FUSE_ALLOWED_ORIGINS=https://fuse.vercel.app

# Fuse 에 노출하지 않을 서버 ID (쉼표로 여러 개)
# FUSE_HIDDEN_GUILDS=
