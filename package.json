{
  "name": "fuse",
  "version": "0.1.3",
  "private": true,
  "description": "Fuse — 스레드 스타일 UI로 쓰는 디스코드 클라이언트",
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "build:icons": "node scripts/build-icons.mjs",
    "release": "node scripts/release.mjs",
    "release:list": "node scripts/release.mjs list",
    "app": "electron .",
    "build:appicon": "electron scripts/make-icon.cjs",
    "build:app": "npm run build:appicon && electron-builder --win",
    "build:app:portable": "electron-builder --win portable"
  },
  "main": "electron/main.cjs",
  "build": {
    "appId": "im.fuse.desktop",
    "productName": "Fuse",
    "copyright": "Fuse",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "src/**/*",
      "public/**/*",
      "package.json",
      "!**/*.map"
    ],
    "extraMetadata": {
      "main": "electron/main.cjs"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Fuse"
    },
    "portable": {
      "artifactName": "Fuse-${version}-portable.exe"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "discord.js": "^14.16.3",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "lucide": "^1.33.0",
    "morphicons": "^1.7.0",
    "multer": "^1.4.5-lts.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3"
  }
}
